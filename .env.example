# Dummy local values only. Copy to .env; never commit .env.
VEXLEDGER_ENV=dev
VEXLEDGER_LOG_LEVEL=INFO
VEXLEDGER_DATABASE_URL=postgresql+asyncpg://vexledger:vexledger@localhost:5433/vexledger
VEXLEDGER_REDIS_URL=redis://localhost:6380/0
VEXLEDGER_OSV_BASE_URL=https://api.osv.dev
VEXLEDGER_VEX_BASE_URL=http://localhost:8000
VEXLEDGER_MAX_UPLOAD_MB=25
VEXLEDGER_EVIDENCE_DIR=./data/evidence
# JSON list of explicit browser origins allowed to call the API with cookies, e.g. ["http://localhost:3000"]
VEXLEDGER_CORS_ORIGINS=[]
# Used only by `vexledger create-admin` (otherwise it asks on the terminal). Dummy value:
# VEXLEDGER_ADMIN_PASSWORD=change-me-to-a-long-passphrase
