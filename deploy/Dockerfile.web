# The UI is a client-side SPA: `nuxt generate` makes static files, served by unprivileged nginx.
# Caddy sends /api to the backend, so no API address is baked in. Build from the repo root:
#   docker build -f deploy/Dockerfile.web -t vexledger-web .
FROM node:24-slim AS build
WORKDIR /web
# Some Docker networks have broken IPv6; prefer IPv4 so `npm ci` does not stall.
ENV NODE_OPTIONS=--dns-result-order=ipv4first
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY web ./
RUN npx nuxt generate \
    && test -s .output/public/index.html && test -s .output/public/200.html  # never ship a blank UI

FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/.output/public /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
    CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/"]
