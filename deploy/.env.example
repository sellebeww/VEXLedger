# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env (never commit it)
# and replace every CHANGE_ME. Generate secrets with: openssl rand -hex 24
# (hex only: the passwords are embedded in URLs, so avoid characters such as @ : / # %).

# Your public domain: Caddy obtains a TLS certificate for it automatically (DNS must already point here).
# Use `localhost` to try it locally with a self-signed certificate.
SITE_ADDRESS=vex.example.com

# Published ports of Caddy. Keep 80 and 443 on a real server (the certificate challenge needs them).
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Base of the OpenVEX @id values, e.g. https://vex.example.com (no trailing slash).
VEXLEDGER_VEX_BASE_URL=https://vex.example.com

# 1 = serve SYNTHETIC OSV records (no internet needed) and show a "DATA DEMO SINTETIS" banner.
# Leave 0 for real use; with 0 the worker calls https://api.osv.dev.
DEMO_OSV_FIXTURES=0

# Optional tuning (defaults are fine).
VEXLEDGER_LOG_LEVEL=INFO
VEXLEDGER_MAX_UPLOAD_MB=25
