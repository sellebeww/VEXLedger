# API and worker share this image (the command differs). Build from the repo root:
#   docker build -f deploy/Dockerfile.backend -t vexledger-backend .
FROM python:3.14-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.12.22 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv sync --locked --no-dev --no-editable

FROM python:3.14-slim
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin vexledger \
    && mkdir -p /data/evidence && chown -R 10001:10001 /data
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY alembic.ini ./
COPY alembic ./alembic
USER 10001
VOLUME /data/evidence
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=8 \
    CMD ["python", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/healthz', timeout=3)"]
# --forwarded-allow-ips=* is safe here only because port 8000 is never published (Caddy reaches it
# over the private compose network); never expose this container directly.
CMD ["uvicorn", "vexledger.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
